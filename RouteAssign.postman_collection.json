{
  "info": {
    "name": "RouteAssign - Auto Delivery Partner Assignment",
    "_postman_id": "routeassign-collection-v1",
    "description": "Complete API collection for the RouteAssign Auto Delivery Partner Assignment System.\n\nBase URL variable: {{baseUrl}} → http://localhost:8080\nAuth token variable: {{token}} → set automatically by the login request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token",   "value": "",                      "type": "string" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@example.com\",\n  \"username\": \"customer1\",\n  \"password\": \"password123\",\n  \"role\": \"CUSTOMER\",\n  \"mobileNo\": \"9876543210\",\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946\n}"
            }
          }
        },
        {
          "name": "Register - Delivery Partner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"partner1@example.com\",\n  \"username\": \"partner1\",\n  \"password\": \"password123\",\n  \"role\": \"DELIVERY_PARTNER\",\n  \"mobileNo\": \"9123456780\",\n  \"latitude\": 12.9352,\n  \"longitude\": 77.6245\n}"
            }
          }
        },
        {
          "name": "Register - Vendor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vendor1@example.com\",\n  \"username\": \"vendor1\",\n  \"password\": \"password123\",\n  \"role\": \"VENDOR\",\n  \"mobileNo\": \"9000000001\",\n  \"latitude\": 12.9500,\n  \"longitude\": 77.6100\n}"
            }
          }
        },
        {
          "name": "Register - Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@routeassign.com\",\n  \"username\": \"admin\",\n  \"password\": \"adminpass123\",\n  \"role\": \"ADMIN\",\n  \"mobileNo\": \"9000000000\",\n  \"latitude\": null,\n  \"longitude\": null\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "    console.log('Token saved:', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },

